# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
API_PREFIX=/api

FABRIC_ORG_PATH=../Academic_RecordsBlockchain/organizations

# Hyperledger Fabric Configuration
CHANNEL_NAME=academic-records-channel
CHAINCODE_NAME=academic-records
MSP_ID=NITWarangalMSP

# Connection Profile Path (relative to backend root)
CONNECTION_PROFILE_PATH=../Academic_RecordsBlockchain/organizations/peerOrganizations/nitwarangal.nitw.edu/connection-nitwarangal.json

# Wallet Path
WALLET_PATH=./wallet

# Admin Credentials
ADMIN_USER_ID=admin
ADMIN_PASSWORD=adminpw

# CA Configuration
CA_URL=https://localhost:8054
CA_NAME=ca.nitwarangal.nitw.edu
CA_TLS_CERT_PATH=../Academic_RecordsBlockchain/organizations/fabric-ca/nitwarangal/ca-cert.pem

# Gateway Discovery
GATEWAY_DISCOVERY_ENABLED=true
GATEWAY_DISCOVERY_AS_LOCALHOST=false

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/backend.log

# Security (set strong values for production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:4200

# IPFS Pinata Configuration
PINATA_API_KEY=0d5263127757320f3ba5
PINATA_SECRET_API_KEY=a7edef83d0ddd6dd43f8133e44d9fa5e29a7966d365b80a862846a5ae6561043
PINATA_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..CuggALDN_OO8h3tbgl72CIutSNwb5f0Dg-8oKQ3IRKw

# Distributed Data Sync
# ADMIN NODE (Aditi): leave blank or set to localhost
# REMOTE NODES: set to the admin machine's IP (172.20.240.7)
# All data (users, departments, courses, marks) syncs through the admin node
ADMIN_HOST=
ADMIN_BACKEND_PORT=3000
