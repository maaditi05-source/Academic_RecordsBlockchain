# =================================================================
# Backend Configuration for Verifiers Organization (Machine 4)
# Copy this file as .env on the Verifiers machine's backend
# =================================================================

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
API_PREFIX=/api

# --- CHANGE THIS to point to where crypto material is on this machine ---
FABRIC_ORG_PATH=../Academic_RecordsBlockchain/organizations

# Hyperledger Fabric Configuration
CHANNEL_NAME=academic-records-channel
CHAINCODE_NAME=academic-records
MSP_ID=VerifiersMSP

# Connection Profile Path (relative to backend root)
CONNECTION_PROFILE_PATH=../Academic_RecordsBlockchain/organizations/peerOrganizations/verifiers.nitw.edu/connection-verifiers.json

# Wallet Path
WALLET_PATH=./wallet

# Admin Credentials
ADMIN_USER_ID=admin
ADMIN_PASSWORD=adminpw

# CA Configuration — CHANGE IP to this machine's IP in multi-host mode
CA_URL=https://localhost:11054
CA_NAME=ca-verifiers
CA_TLS_CERT_PATH=../Academic_RecordsBlockchain/organizations/fabric-ca/verifiers/ca-cert.pem

# Gateway Discovery — CRITICAL for multi-host
GATEWAY_DISCOVERY_ENABLED=true
GATEWAY_DISCOVERY_AS_LOCALHOST=false
# ↑ Set to 'false' when deploying across multiple machines!

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/backend.log

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# CORS — CHANGE to the actual frontend URL of this machine
CORS_ORIGIN=http://localhost:4200
