# Backend .env for Node 12 — Student Portal (SDK-only, no peer)
# This machine has NO local peer — backend connects to peer0.nitwarangal via gateway
# Students: view records, request certificates, grant consent

PORT=3008
HOST=0.0.0.0
NODE_ENV=development
API_PREFIX=/api

FABRIC_ORG_PATH=../Academic_RecordsBlockchain/organizations
CHANNEL_NAME=academic-records-channel
CHAINCODE_NAME=academic-records
MSP_ID=NITWarangalMSP

# Connection profile lists peer0.nitwarangal as the gateway peer
CONNECTION_PROFILE_PATH=../Academic_RecordsBlockchain/organizations/peerOrganizations/nitwarangal.nitw.edu/connection-nitwarangal.json
WALLET_PATH=./wallet-student-portal
ADMIN_USER_ID=admin
ADMIN_PASSWORD=adminpw

# Student portal backend talks to NITW CA (on Node 04) for enrollment
CA_URL=https://localhost:8054
CA_NAME=ca-nitwarangal
CA_TLS_CERT_PATH=../Academic_RecordsBlockchain/organizations/fabric-ca/nitwarangal/ca-cert.pem

GATEWAY_DISCOVERY_ENABLED=true
GATEWAY_DISCOVERY_AS_LOCALHOST=false
# Set to false + change CA_URL to Node04's real IP for multi-host

LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/backend-student-portal.log

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:4208
