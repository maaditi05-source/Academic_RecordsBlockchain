# Backend .env for Node 06 — CSE Department Peer
# Used by CSE faculty and HOD for marks submission and HOD approval

PORT=3002
HOST=0.0.0.0
NODE_ENV=development
API_PREFIX=/api

FABRIC_ORG_PATH=../Academic_RecordsBlockchain/organizations
CHANNEL_NAME=academic-records-channel
CHAINCODE_NAME=academic-records
MSP_ID=DepartmentsMSP

CONNECTION_PROFILE_PATH=../Academic_RecordsBlockchain/organizations/peerOrganizations/departments.nitw.edu/connection-departments.json
WALLET_PATH=./wallet-cse
ADMIN_USER_ID=admin
ADMIN_PASSWORD=adminpw

CA_URL=https://localhost:9054
CA_NAME=ca-departments
CA_TLS_CERT_PATH=../Academic_RecordsBlockchain/organizations/fabric-ca/departments/ca-cert.pem

GATEWAY_DISCOVERY_ENABLED=true
GATEWAY_DISCOVERY_AS_LOCALHOST=true

LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/backend-cse.log

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:4202
